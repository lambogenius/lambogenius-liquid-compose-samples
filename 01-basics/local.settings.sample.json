{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet",
    "APP_KIND": "workflowApp",
    "FUNCTIONS_INPROC_NET8_ENABLED": "1",
    "LiquidCompose__AllowScripts": "true",
    "LiquidCompose__FunctionRegistryPath": "functions.json",
    "LiquidCompose__Development__AllowLocalhostHttp": "true",
    "LiquidCompose__MaxTimeoutSeconds": "60",
    "LiquidCompose__Worker__Count": "2",
    "LiquidCompose__Worker__QueueLimit": "20"
  }
}
