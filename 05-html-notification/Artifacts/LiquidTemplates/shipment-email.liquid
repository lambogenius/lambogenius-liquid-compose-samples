{% csharp %}
// "Purolator|PUR 1234 5678" -> the carrier's tracking page for that number.
public string TrackingUrl(string carrierAndNumber)
{
    var parts = (carrierAndNumber ?? "").Split('|', 2);
    var number = Uri.EscapeDataString(parts.Length == 2 ? Regex.Replace(parts[1], @"\s", "") : "");
    switch (parts[0].Trim().ToLowerInvariant())
    {
        case "canada post": return "https://www.canadapost-postescanada.ca/track-reperage/en#/details/" + number;
        case "purolator": return "https://www.purolator.com/en/shipping/tracker?pin=" + number;
        case "ups": return "https://www.ups.com/track?tracknum=" + number;
        default: return "https://track.example.com/?n=" + number;
    }
}

// "fr|2026-10-24" -> "samedi 24 octobre 2026"; "en|2026-10-24" -> "Saturday, October 24, 2026".
public string LongDate(string languageAndDate)
{
    var parts = (languageAndDate ?? "").Split('|', 2);
    var date = DateTime.ParseExact(parts[1], "yyyy-MM-dd", CultureInfo.InvariantCulture);
    return parts[0] == "fr"
        ? date.ToString("dddd d MMMM yyyy", CultureInfo.GetCultureInfo("fr-CA"))
        : date.ToString("dddd, MMMM d, yyyy", CultureInfo.GetCultureInfo("en-CA"));
}
{% endcsharp %}
{%- comment -%}
  Every value that comes from the order is passed through Escape, so a name or a gift message can't add HTML to the
  email. Partials in partials/ share this template's variables (lang, item, ...).
{%- endcomment -%}
{%- assign lang = content.customer.language | Default: 'en' | Downcase -%}
{%- if lang != 'fr' -%}{%- assign lang = 'en' -%}{%- endif -%}
{%- assign trackingUrl = content.shipment.carrier | Append: '|' | Append: content.shipment.trackingNumber | CallCSharp: 'TrackingUrl' -%}
{%- assign eta = lang | Append: '|' | Append: content.shipment.estimatedDelivery | CallCSharp: 'LongDate' -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{% if lang == 'fr' %}Votre commande {{ content.orderNumber | Escape }} est en route{% else %}Your order {{ content.orderNumber | Escape }} is on its way{% endif %}</title>
</head>
<body style="margin:0;padding:24px;background:#f4f4f7;font-family:Arial,Helvetica,sans-serif;color:#222">
<table role="presentation" width="100%" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:8px;padding:24px">
<tr><td>
<h1 style="font-size:20px;margin:0 0 16px">{% if lang == 'fr' %}Bonjour {{ content.customer.firstName | Escape }},{% else %}Hi {{ content.customer.firstName | Escape }},{% endif %}</h1>
<p>{% if lang == 'fr' %}Votre commande <strong>{{ content.orderNumber | Escape }}</strong> a été expédiée par {{ content.shipment.carrier | Escape }}. Livraison prévue&nbsp;: <strong>{{ eta }}</strong>.{% else %}Your order <strong>{{ content.orderNumber | Escape }}</strong> has shipped with {{ content.shipment.carrier | Escape }}. Expected delivery: <strong>{{ eta }}</strong>.{% endif %}</p>
<p><a href="{{ trackingUrl | Escape }}" style="display:inline-block;background:#5c2d91;color:#ffffff;text-decoration:none;padding:10px 16px;border-radius:4px">{% if lang == 'fr' %}Suivre le colis{% else %}Track the package{% endif %}</a></p>
<table role="presentation" width="100%" style="border-collapse:collapse;margin:16px 0">
<tr><th align="left" style="border-bottom:1px solid #ddd;padding:6px 0">{% if lang == 'fr' %}Article{% else %}Item{% endif %}</th><th align="right" style="border-bottom:1px solid #ddd;padding:6px 0">{% if lang == 'fr' %}Qté{% else %}Qty{% endif %}</th></tr>
{% for item in content.items -%}
{% include 'partials/item-row.liquid' %}
{% endfor -%}
</table>
{% if content.giftMessage -%}
<p style="background:#faf6ff;border-left:4px solid #5c2d91;padding:8px 12px">{% if lang == 'fr' %}Votre message-cadeau&nbsp;:{% else %}Your gift message:{% endif %} {{ content.giftMessage | Escape | NewlineToBr }}</p>
{% endif -%}
{% include 'partials/footer.liquid' %}
</td></tr>
</table>
</body>
</html>
