<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      packages/ holds Lambogenius.LiquidCompose.LogicApps.<version>.nupkg, downloaded from lambogenius.com.
      Every sample's project finds it through this file. In your own project, add the folder or feed that holds it.
    -->
    <add key="liquid-compose" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
